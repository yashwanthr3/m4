{
  "name": "trust-course-studio",
  "private": true,
  "workspaces": ["apps/ui", "apps/orchestrator"],
  "scripts": {
    "dev": "npm run dev -w apps/orchestrator & npm run dev -w apps/ui",
    "build": "npm run build -w apps/ui",
    "start": "npm run build && node apps/orchestrator/src/server.js",
    "vendor:check": "node scripts/vendor.mjs check",
    "vendor:lock": "node scripts/vendor.mjs lock",
    "vendor:diff": "node scripts/vendor.mjs diff",
    "test": "node --test tests/",
    "test:parity": "node --test tests/parity.test.js"
  }
}
