 };
+/* pattern: one catalogue pattern in a sandboxed frame (Trust Course Studio patch).
+   The frame gets the course palette through the theme adapter ({type:'trust-theme', vars, theme, only}).
+   Its Remember card or debrief message ({type:'trust-pattern', event:'remember'|'debrief'|'done'}) is the gate. */
+const PATTERN_CSP="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:";
+/* course token -> pattern token (same table as vendor/patterns/themes.mjs) */
+const PATTERN_MAP={'--bg':'--card','--surface':'--card-2','--surface-2':'--ground','--ink':'--ink','--ink-2':'--ink-2','--muted':'--ink-3','--line':'--rule','--accent':'--link','--on-accent':'--card','--accent-soft':'--ground-2','--good':'--ok','--good-soft':'--ok-soft','--bad':'--no','--bad-soft':'--no-soft','--warn':'--warn','--warn-soft':'--warn-soft','--font-body':'--body','--font-display':'--display','--font-sign':'--sign'};
+function patternVars(){ const cs=getComputedStyle(document.documentElement); const v={}; for(const k in PATTERN_MAP) v[k]=cs.getPropertyValue(PATTERN_MAP[k]).trim(); return v; }
+function patternScheme(){ const t=document.documentElement.dataset.theme; if(t==='dark'||t==='light') return t; return matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'; }
+RENDER.pattern=(b,ctx,done)=>{
+  const e=h('div','ask pat'); if(b.prompt) e.appendChild(h('p','prompt',interp(b.prompt)));
+  const pages=(window.COURSE&&COURSE.patterns)||{}; const src=pages[b.n];
+  const box=h('div','patbox'); e.appendChild(box);
+  let finished=false;
+  const fin=(ev,practised)=>{ if(finished) return; finished=true; window.removeEventListener('message',onMsg); solveMark(skip,false); row.remove();
+    ctx.vals[b.id||('pattern'+b.n)]={display:practised?'practised':'skipped'};
+    if(practised){ ctx.award(15); sfx.ok(); } else ctx.award(5);
+    box.classList.add('done'); if(b.fb) fb(e,'neutral',b.fb); done(); };
+  const row=h('div','row'); const skip=h('button','btn ghost small',esc(b.skipLabel||'Continue without practising')); solveMark(skip,true); row.appendChild(skip);
+  skip.onclick=()=>fin('skip',false);
+  if(!src){ box.appendChild(h('p','hint','This practice is not available offline.')); e.appendChild(row); return {el:e,gate:true}; }
+  const fr=document.createElement('iframe'); fr.className='patframe'; fr.setAttribute('sandbox','allow-scripts'); fr.setAttribute('title',stripTags(b.title||b.prompt||'Practice')); fr.setAttribute('loading','lazy');
+  fr.dataset.pattern=String(b.n);
+  fr.srcdoc='<meta http-equiv="Content-Security-Policy" content="'+PATTERN_CSP+'">'+src.replace(/<link[^>]+fonts\.googleapis[^>]*>/gi,'');
+  const theme=()=>{ try{ fr.contentWindow.postMessage({type:'trust-theme',vars:patternVars(),theme:patternScheme(),only:b.n},'*'); }catch(_){} };
+  fr.addEventListener('load',theme);
+  const onMsg=(ev)=>{ if(ev.source!==fr.contentWindow) return; const d=ev.data||{};
+    if(d.type==='trust-height'&&d.h>0) fr.style.height=Math.min(Math.max(240,+d.h),1600)+'px';
+    if(d.type==='trust-pattern'&&(d.event==='remember'||d.event==='debrief'||d.event==='done')&&d.n==b.n) fin(d.event,true); };
+  window.addEventListener('message',onMsg);
+  const mq=matchMedia('(prefers-color-scheme: dark)'); mq.addEventListener&&mq.addEventListener('change',theme);
+  box.appendChild(fr); e.appendChild(row);
+  return {el:e,gate:true};
+};
 RENDER.reflect=(b,ctx,done)=>{
   const e=h('div','ask');
   e.appendChild(h('div','sit','<span class="eyebrow">'+(b.label||T('reflect'))+'</span><p class="s">'+interp(b.prompt)+'</p>'));
